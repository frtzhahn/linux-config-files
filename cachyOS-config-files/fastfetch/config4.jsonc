{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/icons/mocha.gif",
    "type": "kitty",
    "animationFrame": 0,
    "position": "left",
    "height": 20,
    "width": 38,
    "padding": {
      "top": 1,
      "right": 4,
      "left": 1
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 15
    }
  },
  "modules": [
    // ─── CARD 1: SYSTEM ──────────────────────────────────────────
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m╭─ \u001b[38;2;203;166;247m󰣇 SYSTEM\u001b[38;2;108;112;134m ───────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "title",
      "key": "\u001b[38;2;108;112;134m│\u001b[0m   User",
      "keyColor": "38;2;180;190;254",
      "format": "{user-name}@{host-name}\u001b[96G\u001b[38;2;108;112;134m   │\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;108;112;134m│\u001b[0m 󰣇  OS",
      "keyColor": "38;2;180;190;254",
      "format": "{sysname} {architecture}\u001b[96G\u001b[38;2;108;112;134m   │\u001b[0m"
    },
    {
      "type": "host",
      "key": "\u001b[38;2;108;112;134m│\u001b[0m 󰌢  Host",
      "keyColor": "38;2;180;190;254",
      "format": "{name}\u001b[96G\u001b[38;2;108;112;134m   │\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;108;112;134m│\u001b[0m 󰒋  Kernel",
      "keyColor": "38;2;180;190;254",
      "format": "{sysname} {release}\u001b[96G\u001b[38;2;108;112;134m   │\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;108;112;134m│\u001b[0m   Uptime",
      "keyColor": "38;2;180;190;254",
      "format": "{days} days, {hours} hours, {mins} mins\u001b[96G\u001b[38;2;108;112;134m   │\u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;108;112;134m│\u001b[0m 󰏖  Packages",
      "keyColor": "38;2;180;190;254",
      "format": "{all} (pacman, flatpak)\u001b[96G\u001b[38;2;108;112;134m   │\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m╰──────────────────────────────────────────────────────╯\u001b[0m"
    },
    // ─── GUTTER 1 ────────────────────────────────────────────────
    {
      "type": "custom",
      "format": " "
