{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii-art-6-colored.txt",
    "type": "file",
    "position": "left",
    "padding": {
      "top": 0,
      "right": 4,
      "left": 1
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 15
    }
  },
  "modules": [
    // ─── CARD 1: SYSTEM (8 lines: 1-8) ───────────────────
    {
      "type": "custom",
      "format": "╭─ \u001b[38;2;203;166;247m󰣇 SYSTEM\u001b[0m ───────────────────────────────────────────╮"
    },
    {
      "type": "title",
      "key": "│  User",
      "keyColor": "blue",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "│ 󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "│ 󰌢 Host",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│ 󰒋 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "│  Uptime",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages",
      "keyColor": "blue",
      "format": "{all} (pacman, flatpak)"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────╯"
    },
    // ─── GUTTER (1 line: 9) ──────────────────────────────
    {
      "type": "custom",
      "format": " "
    },
    // ─── CARD 2: DESKTOP (8 lines: 10-17) ────────────────
    {
      "type": "custom",
      "format": "╭─ \u001b[38;2;116;199;236m DESKTOP\u001b[0m ──────────────────────────────────────────╮"
    },
    {
      "type": "wm",
      "key": "│  WM",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "│  Shell",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│  Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "terminalfont",
      "key": "│  Font",
      "keyColor": "cyan"
    },
    {
      "type": "theme",
      "key": "│ 󰉼 Theme",
      "keyColor": "cyan"
    },
    {
      "type": "cursor",
      "key": "│ 󰆿 Cursor",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────╯"
    },
    // ─── GUTTER (1 line: 18) ─────────────────────────────
    {
      "type": "custom",
      "format": " "
    },
    // ─── CARD 3: HARDWARE & RESOURCES (9 lines: 19-27) ───
    {
      "type": "custom",
      "format": "╭─ \u001b[38;2;166;227;161m HARDWARE & STORAGE\u001b[0m ───────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "│  CPU",
      "keyColor": "green",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ 󰍛 Memory",
      "keyColor": "green",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "swap",
      "key": "│ 󰓡 Swap",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│  Storage",
      "keyColor": "green",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "│ 󱊢 Battery",
      "keyColor": "green"
    },
    {
      "type": "media",
      "key": "│ 󰝚 Media",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────╯"
    },
    // ─── GUTTER (1 line: 28) ─────────────────────────────
    {
      "type": "custom",
      "format": " "
    },
    // ─── FOOTER / PALETTE (4 lines: 29-32) ───────────────
    {
      "type": "custom",
      "format": "             ╭──────────────────────────────╮"
    },
    {
      "type": "custom",
      "format": "             │       \u001b[38;2;249;226;175m󰮯 \u001b[38;2;243;139;168m󰊠 \u001b[38;2;250;179;135m󰊠 \u001b[38;2;166;227;161m󰊠 \u001b[38;2;116;199;236m󰊠 \u001b[38;2;137;180;250m󰊠 \u001b[38;2;203;166;247m󰊠 \u001b[38;2;180;190;254m󰊠 \u001b[0m       │"
    },
    {
      "type": "custom",
      "format": "             │       \u001b[38;2;249;226;175m● \u001b[38;2;243;139;168m● \u001b[38;2;250;179;135m● \u001b[38;2;166;227;161m● \u001b[38;2;116;199;236m● \u001b[38;2;137;180;250m● \u001b[38;2;203;166;247m● \u001b[38;2;180;190;254m●\u001b[0m        │"
    },
    {
      "type": "custom",
      "format": "             ╰──────────────────────────────╯"
    }
  ]
}
