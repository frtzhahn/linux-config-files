{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
				"source": "~/.config/fastfetch/ascii-art-5.txt",
				"padding": {
						"top": 2,
						"left": 2,
						"right": 4
					}
			},
    "display": {
        "separator": " "
    },
    "modules": [
        "break",

	{
            "type": "custom",
            "format": "\u001b[37m╔════════════════════════ ★ OPERATING SYSTEM ★ ════════════════════════╗"
        },
	//"break",

	{
            "type":"title",
            "keyWidth": 10
        },
        "break",

//        { 
//            "type": "colors",
//            "symbol": "Circle",
//            "count": 36
//         },

         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "31",
        },
        {
            "type": "kernel",
            "key": " ├ ",
            "keyColor": "31",
        },
        {
            "type": "packages",
	    "format": "{} (packages installed)",
            "key": " ├ 󰏖 ",
            "keyColor": "31",  
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "31", 
        },

	{
            "type": "custom",
            "format": "\u001b[37m╚══════════════════════════════════════════════════════════════════════╝"
        },

        "break",

        	{
            "type": "custom",
            "format": "\u001b[37m╔════════════════════════ ★  WINDOW MANAGER  ★ ════════════════════════╗"
        },

        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "32", 
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "32",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "32",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "32", 
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "32",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "32", 
        },

        	{
            "type": "custom",
            "format": "\u001b[37m╚══════════════════════════════════════════════════════════════════════╝"
        },

        "break",
                	{
            "type": "custom",
            "format": "\u001b[37m╔════════════════════════ ★     MY SPECS     ★ ════════════════════════╗"
        },

        {
            "type": "host",
            "format": "{5} {1} Type {2}",
            "key": "PC   ",
            "keyColor": "36",
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7} GHz",
            "key": " ├  ",
            "keyColor": "36",
        },
        {
            "type": "gpu",
            "format": "{1} {2} @ {12} GHz",            
            "key": " ├ 󰢮 ",
            "keyColor": "36",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "36",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "36",
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "36",
        },
        {
            "type": "monitor",
            "key": " └  ",
            "keyColor": "36",
        },
        {
            "type": "media",
            "key": "🎶",
        },
        {
            "type": "player",
            "key": "",
            "keyColor": "32", 
        },

        //"break",
	//"break",
        {
            "type": "custom",
            "format": "                        \u001b[91m \u001b[90m●  \u001b[31m●  \u001b[32m●  \u001b[33m●  \u001b[34m●  \u001b[35m●  \u001b[36m●  \u001b[37m● "
        },

	//"break",

	{
            "type": "custom",
            "format": "\u001b[37m╚══════════════════════════════════════════════════════════════════════╝"
        },
    ]
}
